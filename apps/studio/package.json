{
	"name": "@pencilpilot/studio",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "PencilPilot: the drawing and frame-by-frame animation app (Tauri 2 + Svelte)",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"tauri": "tauri",
		"app": "tauri dev",
		"app:build": "tauri build"
	},
	"dependencies": {
		"@pencilpilot/paint": "workspace:*",
		"@pencilpilot/ui": "workspace:*",
		"pencilpilot-brush-wasm": "workspace:*",
		"@tauri-apps/api": "^2.12.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.6",
		"@types/node": "^26",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8"
	}
