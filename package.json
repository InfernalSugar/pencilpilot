{
  "name": "pencilpilot",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "wasm": "wasm-pack build crates/grader-wasm --target web --out-dir pkg --out-name grader",
    "dev": "pnpm wasm && pnpm --filter @pencilpilot/web dev",
    "build": "pnpm wasm && pnpm --filter @pencilpilot/web build",
    "lint": "pnpm --filter @pencilpilot/web lint",
    "check": "pnpm --filter @pencilpilot/web check",
    "test": "pnpm --filter @pencilpilot/web test:unit -- --run"
  }
}
